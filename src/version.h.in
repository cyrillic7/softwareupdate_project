#ifndef VERSION_H
#define VERSION_H

#define APP_NAME "@PROJECT_NAME@"
#define APP_VERSION "@PROJECT_VERSION@"
#define APP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define APP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define APP_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define BUILD_PLATFORM "@PLATFORM_NAME@"
#define BUILD_ARCHITECTURE "@CMAKE_SYSTEM_PROCESSOR@"
#define BUILD_COMPILER "@CMAKE_CXX_COMPILER_ID@"
#define BUILD_TYPE "@CMAKE_BUILD_TYPE@"

#ifdef ARM_PLATFORM
#define IS_ARM_BUILD true
#else
#define IS_ARM_BUILD false
#endif

#ifdef DEBUG_BUILD
#define IS_DEBUG_BUILD true
#else
#define IS_DEBUG_BUILD false
#endif

// 构建时间戳（如果需要的话）
#define BUILD_TIMESTAMP __DATE__ " " __TIME__

// 功能特性宏
#ifdef LINUX_PLATFORM
#define PLATFORM_SUPPORTS_TERMINAL_DETECTION 1
#define PLATFORM_SUPPORTS_MULTI_ARCH 1
#else
#define PLATFORM_SUPPORTS_TERMINAL_DETECTION 0
#define PLATFORM_SUPPORTS_MULTI_ARCH 0
#endif

#endif // VERSION_H 